<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Habilitations de l'application de bureau macOS.

  Le « hardened runtime » ferme par defaut des portes dont Chromium a besoin :
  sans ces quatre lignes, l'application se ferme au demarrage ou reste muette,
  et le message d'erreur ne dit pas pourquoi.
-->
<plist version="1.0">
<dict>
  <!-- Le moteur JavaScript compile a la volee. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <!-- Le moteur vocal tourne en WebAssembly, hors des pages signees. -->
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- Signature « ad hoc » : sans cela, macOS refuse de charger les
       bibliotheques d'Electron, qui portent une autre signature. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- Le micro, c'est-a-dire l'outil lui-meme. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
