{
  "name": "souffleur",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Téléprompteur qui suit la voix de l'orateur dans son texte : suivi vocal, chronométrage et annotations de scène",
  "scripts": {
    "android": "node scripts/build.js && npx cap sync android && node scripts/android-manifest.js && npx cap open android",
    "android:manifest": "node scripts/android-manifest.js",
    "app": "electron .",
    "bench": "node test/bench.js",
    "build": "node scripts/build.js",
    "dev": "node scripts/serve.js",
    "dev:https": "node scripts/serve.js --https",
    "dmg": "npm run preparer && electron-builder --mac dmg",
    "linux": "npm run preparer && electron-builder --linux",
    "model": "node scripts/model.js",
    "postinstall": "node scripts/vendor.js",
    "preparer": "node scripts/vendor.js && node scripts/build-check.js",
    "test": "node --test test/*.test.js",
    "vendor": "node scripts/vendor.js",
    "windows": "npm run preparer && electron-builder --win"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "vosk-browser": "0.0.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "main": "electron/main.js",
  "desktopName": "souffleur.desktop",
  "overrides": {
    "uuid": "^11.1.1"
  },
  "build": {
    "appId": "fr.souffleur.app",
    "productName": "Souffleur",
    "copyright": "Souffleur",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "index.html",
      "src/**/*",
      "vendor/**/*",
      "models/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*",
      "!**/*.map"
    ],
    "asar": false,
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "darkModeSupport": true,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Souffleur écoute votre voix pour suivre votre position dans le texte. L'audio ne quitte jamais cet appareil."
      },
      "identity": "-",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "title": "Souffleur ${version}",
      "contents": [
        {
          "x": 140,
          "y": 200,
          "type": "file"
        },
        {
          "x": 400,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Office",
      "maintainer": "Souffleur",
      "syncDesktopName": true,
      "synopsis": "Téléprompteur qui suit la voix de l'orateur dans son texte"
    }
  }
}
