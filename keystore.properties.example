# Copiez ce fichier en « keystore.properties » et renseignez-le.
# Ce fichier n'est jamais versionné : une clé de publication ne se partage pas.
#
# Créer la clé (une seule fois, puis la sauvegarder précieusement — la perdre
# signifie ne plus jamais pouvoir mettre l'application à jour) :
#
#   keytool -genkey -v -keystore souffleur-upload.jks \
#     -alias souffleur -keyalg RSA -keysize 2048 -validity 10000
#
storeFile=souffleur-upload.jks
storePassword=
keyAlias=souffleur
keyPassword=
